# Copy to .env.local for local work. Production uses the VPS runtime .env and
# GitHub Actions secret DEPLOY_ENV_FILE_B64.
# The public site needs NONE of these; they power /admin, the build-time merge,
# cron endpoints, and VPS deployment builds.

# Canonical origin. Set once the real domain is attached.
NEXT_PUBLIC_SITE_URL=https://mymp.bd

# Shared PostgreSQL database. MYMP uses public; Sangsad uses the sangsad schema.
DATABASE_URL=
# Self-hosted plain PostgreSQL may use disable; hosted Supabase should use require.
DATABASE_SSL=require
DATABASE_SCHEMA=sangsad

# Shared self-hosted Supabase project → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same shared Supabase project; its public Storage mirror bucket is used by builds.
SANGSAD_SUPABASE_URL=
# Secret. Used only inside server actions and the build-time sync.
SUPABASE_SERVICE_ROLE_KEY=

# The first super admin. Create this user in Supabase → Authentication → Users first,
# then sign in at /admin/login; the row is created on that first sign-in.
ADMIN_BOOTSTRAP_EMAIL=

# Obsolete after VPS cutover. Sangsad dispatches GitHub Actions directly.
VERCEL_DEPLOY_HOOK_URL=

# Any long random string. Supabase Cron and GitHub Actions send it as a
# bearer token to the protected /api/cron/* routes. See docs/vps-deployment.md.
CRON_SECRET=

# The posts sync (src/lib/posts/sync.ts) emails its summary to mymp.bangladesh@gmail.com through
# Resend (resend.com → API Keys). Until mymp.bd is verified in Resend, leave MAIL_FROM unset: the
# test sender only delivers to the address the Resend account was opened with, so open it with
# mymp.bangladesh@gmail.com. Once the domain is verified, e.g. MAIL_FROM=আমার এমপি <sync@mymp.bd>
RESEND_API_KEY=
MAIL_FROM=

# GitHub → repository Settings → Secrets → Actions: MYMP_CRON_SECRET = the same value as CRON_SECRET,
# for the six-hourly .github/workflows/sync-posts.yml.
