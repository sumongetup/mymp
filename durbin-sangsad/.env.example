# ---- Database (Supabase → Project Settings → Database) ---------------------
# Session pooler URI (port 5432) for migrations and the seed; the transaction
# pooler (port 6543) is fine for the web app. Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Workers and admin server actions only; never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Web -------------------------------------------------------------------
# Where the app lives: "/sangsad" on durbinnews.com, "" on a subdomain.
BASE_PATH=/sangsad
NEXT_PUBLIC_SITE_URL=https://durbinnews.com
# Comma-separated emails that may sign in to /admin before the role table has rows.
ADMIN_EMAILS=info@durbinnews.com

# ---- Local development only ------------------------------------------------
# FIXTURES=1 serves the TEST_-prefixed fixtures in fixtures/ instead of the
# database. The loader refuses to run on a production deployment: when
# VERCEL_ENV=production, when APP_ENV=production, or when NEXT_PUBLIC_SITE_URL
# is durbinnews.com. Set APP_ENV=production on any non-Vercel production host.
FIXTURES=0
APP_ENV=development

# ---- Workers (Phase 4) -----------------------------------------------------
YOUTUBE_API_KEY=
# 1 request per second per domain is enforced in code; this only names the bot.
SCRAPER_USER_AGENT=DurbinNewsSangsadBot/1.0 (+https://durbinnews.com/sangsad/about-data)
