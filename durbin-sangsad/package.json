{
  "name": "durbin-sangsad",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @durbin/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @durbin/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @durbin/db generate",
    "db:migrate": "pnpm --filter @durbin/db migrate",
    "db:seed": "pnpm --filter @durbin/db seed",
    "worker": "pnpm --filter @durbin/worker start",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
