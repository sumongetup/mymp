# ---- Database (sangsad Supabase project → Connect → Session pooler) ---------
# Session pooler URI (port 5432). The direct db.<ref> host is IPv6-only.
# Never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Supabase (Project Settings → API Keys → Legacy) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. The worker's photo copy only.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Fixtures (tests and local experiments only) -----------------------------
# FIXTURES=1 lets code load the TEST_-prefixed files in fixtures/. The loader
# refuses on any production deployment: VERCEL_ENV=production,
# APP_ENV=production, or NEXT_PUBLIC_SITE_URL on mymp.bd.
FIXTURES=0
APP_ENV=development

# ---- Worker ------------------------------------------------------------------
YOUTUBE_API_KEY=
# 1 request per second per domain is enforced in code; this only names the bot.
SCRAPER_USER_AGENT=MyMPBot/1.0 (+https://mymp.bd/somporke)
